# Copy to .env and fill in the keys you have. Every provider is optional.
# Real environment variables take precedence over this file.

# Google Places API (New) — https://developers.google.com/maps/documentation/places/web-service/get-api-key
GOOGLE_PLACES_API_KEY=
# (GOOGLE_MAPS_API_KEY is accepted as an alias)

# SerpAPI — enables two providers: serpapi_maps (Google Maps) and serpapi (Google web results)
SERPAPI_API_KEY=

# Brave Search API — https://brave.com/search/api/
BRAVE_API_KEY=

# Optional: which discovery providers to run (default: auto = every configured one)
# LEADGEN_PROVIDERS=places,serpapi_maps,brave
# Optional: engine for LinkedIn lookups: serpapi, brave, auto or none (default: auto)
# LEADGEN_LINKEDIN_PROVIDER=serpapi
